        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "definition": "label_values(db:exporter_available, db_engine)",
        "hide": 0,
        "includeAll": true,
        "label": "DB Engine",
        "multi": true,
        "name": "db_engine",
        "query": "label_values(db:exporter_available, db_engine)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
